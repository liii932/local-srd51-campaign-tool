<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <display-name>Local 5E Campaign Tool</display-name>

    <!--
        This filter is the first host boundary: it checks the actual servlet request before any
        host page/API handler runs. It never trusts X-Forwarded-* headers.
    -->
    <filter>
        <filter-name>HostBoundaryFilter</filter-name>
        <filter-class>com.dndtool.security.HostBoundaryFilter</filter-class>
        <async-supported>false</async-supported>
    </filter>
    <filter-mapping>
        <filter-name>HostBoundaryFilter</filter-name>
        <url-pattern>/host/*</url-pattern>
        <url-pattern>/api/host/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- Runs only after the loopback boundary and method gate have passed. -->
    <filter>
        <filter-name>HostRequestSecurityFilter</filter-name>
        <filter-class>com.dndtool.security.HostRequestSecurityFilter</filter-class>
        <async-supported>false</async-supported>
    </filter>
    <filter-mapping>
        <filter-name>HostRequestSecurityFilter</filter-name>
        <url-pattern>/host/*</url-pattern>
        <url-pattern>/api/host/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- Tomcat owns the pool; application code resolves it through java:comp/env. -->
    <resource-ref>
        <description>Local 5E Campaign Tool application database pool</description>
        <res-ref-name>jdbc/DndToolSE</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
        <res-sharing-scope>Shareable</res-sharing-scope>
    </resource-ref>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <name>DNDHOSTSESSION</name>
            <path>/</path>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
