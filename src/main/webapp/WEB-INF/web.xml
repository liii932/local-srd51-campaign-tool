<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0" metadata-complete="true">
    <display-name>Local 5E Campaign Tool</display-name>

    <!-- First on every dispatch: no other application resource is visible on the TLS connector. -->
    <filter>
        <filter-name>PlayerBoundaryFilter</filter-name>
        <filter-class>com.dndtool.security.PlayerBoundaryFilter</filter-class>
        <async-supported>false</async-supported>
    </filter>
    <filter-mapping>
        <filter-name>PlayerBoundaryFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
        <dispatcher>INCLUDE</dispatcher>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>

    <!--
        This filter is the first host boundary: it checks the actual servlet request before any
        host page/API handler runs. It never trusts X-Forwarded-* headers.
    -->
    <filter>
        <filter-name>HostBoundaryFilter</filter-name>
        <filter-class>com.dndtool.security.HostBoundaryFilter</filter-class>
        <async-supported>false</async-supported>
    </filter>
    <filter-mapping>
        <filter-name>HostBoundaryFilter</filter-name>
        <url-pattern>/</url-pattern>
        <url-pattern>/host/*</url-pattern>
        <url-pattern>/api/host/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- Runs only after the loopback boundary and method gate have passed. -->
    <filter>
        <filter-name>HostRequestSecurityFilter</filter-name>
        <filter-class>com.dndtool.security.HostRequestSecurityFilter</filter-class>
        <async-supported>false</async-supported>
    </filter>
    <filter-mapping>
        <filter-name>HostRequestSecurityFilter</filter-name>
        <url-pattern>/host</url-pattern>
        <url-pattern>/host/</url-pattern>
        <url-pattern>/host/storage</url-pattern>
        <url-pattern>/api/host/storage/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <listener>
        <listener-class>com.dndtool.web.StorageApplicationListener</listener-class>
    </listener>
    <servlet>
        <servlet-name>HostHomeServlet</servlet-name>
        <servlet-class>com.dndtool.web.HostHomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HostHomeServlet</servlet-name>
        <url-pattern></url-pattern>
        <url-pattern>/host</url-pattern>
        <url-pattern>/host/</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>com.dndtool.web.HealthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/health</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>HostStorageServlet</servlet-name>
        <servlet-class>com.dndtool.web.HostStorageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HostStorageServlet</servlet-name>
        <url-pattern>/host/storage</url-pattern>
        <url-pattern>/api/host/storage/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>HostPlayerServlet</servlet-name>
        <servlet-class>com.dndtool.web.HostPlayerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HostPlayerServlet</servlet-name>
        <url-pattern>/api/host/storage/players/*</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>PlayerServlet</servlet-name>
        <servlet-class>com.dndtool.web.PlayerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PlayerServlet</servlet-name>
        <url-pattern>/player</url-pattern>
        <url-pattern>/player/</url-pattern>
        <url-pattern>/api/player/*</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <name>DNDHOSTSESSION</name>
            <path>/</path>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
</web-app>
