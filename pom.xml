<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dndtool</groupId>
    <artifactId>dnd-tool-se</artifactId>
    <version>0.2.1</version>
    <packaging>war</packaging>

    <name>Local 5E Campaign Tool</name>
    <description>Loopback-only campaign manager for a single game master, based on SRD 5.1.</description>
    <url>https://github.com/liii932/local-srd51-campaign-tool</url>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <junit.version>5.10.2</junit.version>
        <gson.version>2.14.0</gson.version>
        <sqlite.version>3.50.3.0</sqlite.version>
        <tomcat.version>10.1.61</tomcat.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat</groupId>
            <artifactId>tomcat-dbcp</artifactId>
            <version>${tomcat.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <version>${tomcat.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>26.7.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>dnd-tool-se-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>com.dndtool.service.storage.BundledRuleManifestGenerator</mainClass>
                    <classpathScope>runtime</classpathScope>
                </configuration>
                <executions>
                    <execution>
                        <id>bundled-rule-manifest</id>
                        <phase>compile</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <arguments>
                                <argument>${project.build.outputDirectory}/storage/rules</argument>
                                <argument>${project.build.outputDirectory}/storage/rules/bundled-members.tsv</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>fixture-rule-manifest</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <arguments>
                                <argument>${project.basedir}/src/test/fixtures/application-rules/storage/rules</argument>
                                <argument>${project.build.directory}/fixture-rule-manifest/storage/rules/bundled-members.tsv</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Resolve fixed rule fixtures before the application output in Surefire only. -->
                    <classesDirectory>${project.basedir}/src/test/fixtures/application-rules</classesDirectory>
                    <additionalClasspathElements>
                        <additionalClasspathElement>${project.build.directory}/fixture-rule-manifest</additionalClasspathElement>
                        <additionalClasspathElement>${project.build.outputDirectory}</additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <!-- The matching checkout and target/classes supply the offline maintenance tools. -->
                    <packagingExcludes>
                        WEB-INF/classes/com/dndtool/offline/**,
                        WEB-INF/classes/com/dndtool/service/storage/BundledRuleManifestGenerator.class,
                        WEB-INF/classes/com/dndtool/persistence/SchemaMigrations.class,
                        WEB-INF/classes/com/dndtool/persistence/SchemaMigrations$Definition.class,
                        WEB-INF/classes/com/dndtool/persistence/SchemaMigrations$Expectation.class,
                        WEB-INF/classes/com/dndtool/persistence/SchemaMigrations$PackagedSchemaException.class,
                        WEB-INF/classes/com/dndtool/persistence/RuleDatabaseSchemaVerifier.class,
                        WEB-INF/classes/com/dndtool/persistence/RuleDatabaseSchemaVerifier$SchemaMismatchException.class,
                        WEB-INF/classes/db/migration/V001__stage1_schema.sql,
                        WEB-INF/classes/db/migration/V002__stage2_module_schema.sql,
                        WEB-INF/classes/db/migration/V003__builtin_module_draft.sql,
                        WEB-INF/classes/db/migration/V004__release_builtin_module.sql,
                        WEB-INF/classes/db/migration/V005__stage2_character_event_schema.sql,
                        WEB-INF/classes/db/migration/V006__stage2_character_field_value_schema.sql,
                        WEB-INF/classes/db/migration/V007__character_creation_idempotency.sql,
                        WEB-INF/classes/db/migration/V008__stage2_simple_item_schema.sql,
                        WEB-INF/classes/db/migration/V009__stage3_check_execution_schema.sql,
                        WEB-INF/classes/db/migration/V010__stage3_node_encounter_schema.sql,
                        WEB-INF/classes/db/migration/V011__complete_character_catalog_draft.sql,
                        WEB-INF/classes/db/migration/V012__level_one_character_creation.sql,
                        WEB-INF/classes/db/migration/V013__level_advancement_hit_dice.sql,
                        WEB-INF/classes/db/migration/V014__class_feature_lifecycle.sql,
                        WEB-INF/classes/db/migration/V015__multiclass_asi_feat_draft.sql,
                        WEB-INF/classes/db/migration/V016__starting_proficiency_baseline_draft.sql,
                        WEB-INF/classes/db/migration/V017__character_archive_v2_origin.sql,
                        WEB-INF/classes/db/migration/V018__multiclass_spell_slot_foundation.sql,
                        WEB-INF/classes/db/migration/V019__runtime-language-snapshot.sql,
                        WEB-INF/classes/db/migration/V020__runtime-tool-snapshot.sql,
                        WEB-INF/classes/db/migration/V021__schema2-runtime-snapshot.sql,
                        WEB-INF/classes/db/migration/V022__character-proficiency-grants.sql,
                        WEB-INF/classes/db/migration/V023__schema2-runtime-tools.sql,
                        WEB-INF/classes/db/migration/V024__schema2-character-grants.sql,
                        WEB-INF/classes/db/migration/V025__business-write-guard.sql,
                        WEB-INF/classes/db/migration/V026__schema2-initial-plans.sql,
                        WEB-INF/classes/db/migration/V027__schema2-character-runtime.sql,
                        WEB-INF/classes/db/migration/V028__schema2-check-rules.sql,
                        WEB-INF/classes/db/migration/V029__schema2-character-check-history.sql,
                        WEB-INF/classes/db/migration/V030__schema2-equipment-health-rules.sql,
                        WEB-INF/classes/db/migration/V031__schema2-equipment-health-history.sql,
                        WEB-INF/classes/db/migration/V032__schema2-combat-rules.sql,
                        WEB-INF/classes/db/migration/V033__schema2-combat-runtime.sql,
                        WEB-INF/classes/db/migration/V034__schema2-combat-time-ground.sql,
                        WEB-INF/classes/db/migration/V035__schema2-spell-rules.sql,
                        WEB-INF/classes/db/migration/V036__schema2-spell-runtime.sql,
                        WEB-INF/classes/db/migration/V037__schema2-wizard-environment-rules.sql,
                        WEB-INF/classes/db/migration/V038__schema2-reactions-and-ongoing-scenes.sql,
                        WEB-INF/classes/db/migration/V039__schema2-monster-rules.sql,
                        WEB-INF/classes/db/migration/V040__schema2-monster-breath-runtime.sql,
                        WEB-INF/classes/db/migration/V041__schema2-arcane-recovery.sql,
                        WEB-INF/classes/db/migration/V042__schema2-spell-save-damage.sql
                    </packagingExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
