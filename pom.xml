<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dndtool</groupId>
    <artifactId>dnd-tool-se</artifactId>
    <version>0.6.0</version>
    <packaging>war</packaging>

    <name>Local 5E Campaign Tool</name>
    <description>Loopback-only campaign manager for a single game master, based on SRD 5.1.</description>
    <url>https://github.com/liii932/local-srd51-campaign-tool</url>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <junit.version>5.10.2</junit.version>
        <gson.version>2.14.0</gson.version>
        <sqlite.version>3.50.3.0</sqlite.version>
        <tomcat.version>10.1.61</tomcat.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <version>${tomcat.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>dnd-tool-se-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>com.dndtool.service.storage.BundledRuleManifestGenerator</mainClass>
                    <classpathScope>runtime</classpathScope>
                </configuration>
                <executions>
                    <execution>
                        <id>bundled-rule-manifest</id>
                        <phase>compile</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <arguments>
                                <argument>${project.build.outputDirectory}/storage/rules</argument>
                                <argument>${project.build.outputDirectory}/storage/rules/bundled-members.tsv</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>fixture-rule-manifest</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <arguments>
                                <argument>${project.basedir}/src/test/fixtures/application-rules/storage/rules</argument>
                                <argument>${project.build.directory}/fixture-rule-manifest/storage/rules/bundled-members.tsv</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Resolve fixed rule fixtures before the application output in Surefire only. -->
                    <classesDirectory>${project.basedir}/src/test/fixtures/application-rules</classesDirectory>
                    <additionalClasspathElements>
                        <additionalClasspathElement>${project.build.directory}/fixture-rule-manifest</additionalClasspathElement>
                        <additionalClasspathElement>${project.build.outputDirectory}</additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <!-- Standalone author tooling and the build-time generator stay outside the Web artifact. -->
                    <packagingExcludes>
                        WEB-INF/classes/com/dndtool/offline/**,
                        WEB-INF/classes/com/dndtool/service/storage/BundledRuleManifestGenerator.class
                    </packagingExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
