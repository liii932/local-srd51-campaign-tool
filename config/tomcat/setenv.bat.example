@echo off
rem Windows external Tomcat 10.1, launched with startup.bat / catalina.bat.
rem Set JAVA_HOME to a Java 21+ JDK. To override the default campaign directory,
rem set DND_STORAGE_ROOT in the launching environment or use the ROOT.xml example.
rem Example operator input before startup:
rem   set "DND_STORAGE_ROOT=C:\DndToolData\campaigns"
rem Use a private local directory outside Git, WARs and expanded web applications.
rem Windows services use the service identity, environment and JVM options.
rem EnvironmentPropertySource resolves optional HTTPS Connector placeholders.
set "CATALINA_OPTS=%CATALINA_OPTS% -Dorg.apache.tomcat.util.digester.PROPERTY_SOURCE=org.apache.tomcat.util.digester.EnvironmentPropertySource --enable-native-access=ALL-UNNAMED"
