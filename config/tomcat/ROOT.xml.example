<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional external Tomcat 10.1 ROOT context.
  Copy to %CATALINA_BASE%/conf/Catalina/localhost/ROOT.xml only to set an
  application context override. Replace the example path before using it.

  The context value wins over the DND_STORAGE_ROOT process environment.
  With neither set, the app uses .dndtool/campaigns under the Tomcat process's
  Java user.home. Keep the directory private and outside Git, WARs and all
  expanded web applications. A supplied value must be an absolute local path.
-->
<Context>
    <Parameter name="DND_STORAGE_ROOT" value="C:/DndToolData/campaigns" override="false" />
</Context>
